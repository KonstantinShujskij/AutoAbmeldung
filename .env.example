# Образец .env для сервера (скопировать в .env и заполнить; .env в git не попадает).

# Порт на localhost сервера, куда смотрит reverse proxy / Cloudflare Tunnel.
HOST_PORT=4323

# Только для тестового стенда: закрыть сайт паролем (логин:пароль) и запретить индексацию.
# На боевом домене обе строки удалить.
SITE_AUTH=tester:change-me
NOINDEX=1
