# Образец .env для сервера (скопировать в .env и заполнить; .env в git не попадает).

# Порт на localhost сервера, куда смотрит reverse proxy / Cloudflare Tunnel.
HOST_PORT=4323

# Попросить поисковики не индексировать (для тестового домена). На боевом — удалить.
NOINDEX=1

# Сайт открыт для всех. Пароль на весь сайт (логин:пароль) включать только при явной
# необходимости — по умолчанию выключен.
# SITE_AUTH=

# Чтение фото ZB II: без ключа работает только локальный OCR (FIN), с ключом — ещё
# данные владельца и номер (через OpenAI). Модель по умолчанию gpt-5.4-mini.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Публичный адрес сайта: ссылки в письмах и webhook для кнопок Telegram.
PUBLIC_URL=https://example.com

# Telegram: новая заявка → сообщение в рабочую группу (бот должен состоять в группе).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Письма клиенту (SMTP). Без SMTP_HOST и MAIL_FROM письма не отправляются.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AutoFaren <noreply@example.com>"
# MAIL_REPLY_TO=support@example.com

# Письмо с оплатой (кнопка в Telegram): сумма и ссылка на оплату ({id} = номер заявки).
# PRICE_TEXT=19,90 €
# PAYMENT_URL=https://pay.example.com/?ref={id}
