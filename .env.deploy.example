# Образец настроек для `npm run deploy` (скопировать в .env.deploy; .env.deploy в git не попадает).

# Куда заходить по SSH (пользователь должен быть в группе docker).
DEPLOY_SSH=user@server
# Папка с клоном репозитория на сервере.
DEPLOY_DIR=~/autofaren
# Ключ для SSH (можно не задавать, если хост описан в ~/.ssh/config).
DEPLOY_KEY=~/.ssh/autofaren_deploy
# Адрес сайта — просто для подсказки в конце.
DEPLOY_URL=https://example.com
